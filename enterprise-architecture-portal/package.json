{
  "name": "enterprise-architecture-portal",
  "version": "1.0.0",
  "description": "Interactive Enterprise Architecture Portal for Hybrid Offline-First Accounting & POS Platform",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext js,jsx,ts,tsx",
    "lint:fix": "eslint src --ext js,jsx,ts,tsx --fix",
    "format": "prettier --write src",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "analyze": "vite-plugin-visualizer",
    "deploy": "vite build && gh-pages -d dist"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.3",
    "zustand": "^4.4.2",
    "fuse.js": "^7.0.0",
    "mermaid": "^10.6.1",
    "d3": "^7.8.5",
    "cytoscape": "^3.28.0",
    "cytoscape-cose": "^2.0.1",
    "three": "^r159",
    "@react-three/fiber": "^8.15.13",
    "@react-three/drei": "^9.88.11",
    "react-router-dom": "^6.20.0",
    "react-icons": "^4.12.0",
    "react-hot-toast": "^2.4.1",
    "react-intersection-observer": "^9.5.2",
    "react-use-gesture": "^10.3.0",
    "framer-motion": "^10.16.16",
    "classnames": "^2.3.2",
    "date-fns": "^2.30.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.1.1",
    "tailwindcss": "^3.4.1",
    "postcss": "^8.4.32",
    "autoprefixer": "^10.4.16",
    "vite": "^5.0.8",
    "vitest": "^1.1.0",
    "@testing-library/react": "^14.1.2",
    "@testing-library/jest-dom": "^6.1.5",
    "vite-plugin-visualizer": "^0.10.0",
    "gh-pages": "^6.1.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "keywords": [
    "architecture",
    "enterprise",
    "accounting",
    "pos",
    "system-design",
    "documentation",
    "diagrams",
    "visualization"
  ],
  "author": "Arafat Anaam",
  "license": "MIT"
}
